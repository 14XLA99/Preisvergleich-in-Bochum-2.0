{
  "version": 2,
  "builds": [
    { "src": "public/**/*",       "use": "@vercel/static" },
    { "src": "pages/api/**/*.js", "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/",       "dest": "/index.html"        },
    { "src": "/api/(.*)","dest": "/api/$1.js"         },
    { "src": "/(.*)",   "dest": "/$1"                 }
  ]
}
